# PostgreSQL local
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=viveplus
DB_USER=viveplus_local
DB_PASSWORD=cambiar-por-una-clave-local
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Aplicación y autenticación local
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
JWT_SECRET=cambiar-por-un-secreto-aleatorio
NEXTAUTH_SECRET=cambiar-por-otro-secreto-aleatorio
CRON_SECRET=cambiar-por-un-secreto-aleatorio

# Pusher: sustituir por credenciales reales para habilitar chat en tiempo real
PUSHER_APP_ID=local
PUSHER_KEY=local
PUSHER_SECRET=local
PUSHER_CLUSTER=mt1
NEXT_PUBLIC_PUSHER_KEY=local
NEXT_PUBLIC_PUSHER_CLUSTER=mt1

# Stripe: sustituir por claves de prueba para habilitar pagos en modo test
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Email: dejar vacío desactiva el envío real de correos
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_EMAIL=

# Sendcloud: credenciales opcionales para etiquetas y seguimiento de envíos
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=
SENDCLOUD_WEBHOOK_SECRET=
SENDCLOUD_CONTRATO_S=
SENDCLOUD_CONTRATO_M=
SENDCLOUD_CONTRATO_L=
SENDCLOUD_OPCION_S=
SENDCLOUD_OPCION_M=
SENDCLOUD_OPCION_L=

# Ajustes locales opcionales
DOCS_STORAGE_DIR=./public/docs
UMBRAL_STOCK_BAJO=3
ENVIO_GRATIS_DESDE=
TIENDA_NOMBRE=Vive+
TIENDA_DIRECCION=
TIENDA_CP=
TIENDA_CIUDAD=Santander
TIENDA_TELEFONO=
TIENDA_EMAIL=
