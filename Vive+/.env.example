# Demo local: los catálogos y la sesión se sirven desde el navegador/app, sin PostgreSQL.
LOCAL_DEMO=true
NEXT_PUBLIC_LOCAL_DEMO=true
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Claves locales de desarrollo; no habilitan pagos, chat, correo ni envíos reales.
JWT_SECRET=local-demo-jwt-secret-change-before-deploy
NEXTAUTH_SECRET=local-demo-nextauth-secret-change-before-deploy
CRON_SECRET=local-demo-cron-secret
PUSHER_APP_ID=local
PUSHER_KEY=local
PUSHER_SECRET=local
PUSHER_CLUSTER=mt1
NEXT_PUBLIC_PUSHER_KEY=local
NEXT_PUBLIC_PUSHER_CLUSTER=mt1
STRIPE_SECRET_KEY=sk_test_local_demo
STRIPE_WEBHOOK_SECRET=whsec_local_demo
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_local_demo
